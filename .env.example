# External email stays disabled during phase 1.
SCA_EMAIL_ENABLED=false
NEXT_TELEMETRY_DISABLED=1

# Phase 1: local demo only. Generate a unique JWT secret with node scripts/setup-demo.mjs.
# Leave SCA_DEMO_MODE unset in production; institutional persistence/auth is pending.
SCA_DEMO_MODE=true

# Variables de entorno - SCA-QR PWA

# --- Aplicación ---
NEXT_PUBLIC_APP_NAME=SCA-QR
NEXT_PUBLIC_APP_URL=https://sca-qr.tu-dominio.com
SCHOOL_NAME=Colegio Santa María

# --- Auth Admin ---
# IMPORTANTE: cambiar en producción (mínimo 32 caracteres)
JWT_SECRET=

# --- Email (Resend) ---
# Obtener en https://resend.com (free: 3,000 emails/mes)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=SCA-QR Colegio <noreply@tu-dominio.com>

# --- Cache (opcional) ---
# Si defines REDIS_URL, se usa Redis. Si no, memoria local.
# Upstash: https://upstash.com (free: 10K cmd/día)
# REDIS_URL=redis://default:xxx@xxx.upstash.io:6379

# --- Puerto (producción) ---
PORT=3000
NODE_ENV=production
