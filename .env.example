# Generate local configuration with npm run setup:local. Do not copy placeholder secrets.
# The setup stores runtime credentials here and maintenance access in var/maintenance.env.
DATABASE_URL=
SCA_SCHOOL_ID=
JWT_SECRET=
SCA_DEMO_MODE=false
SCA_SYNTHETIC_DATA=false
SCA_EMAIL_ENABLED=false
# Required behind Railway's HTTPS proxy; set the actual published origin without a path.
# SCA_PUBLIC_ORIGIN=https://your-service.up.railway.app
# PORT is assigned by the hosting provider; local default is 3000.
NEXT_TELEMETRY_DISABLED=1
# Optional cache. Redis is neither required nor provisioned.
# REDIS_URL=
# Maintenance-only variables belong in a private file outside the application's runtime environment:
# MIGRATION_DATABASE_URL=
# SCA_BACKUP_KEY_FILE=var/backup.key
# SCA_DB_CONTAINER=sca-qr-postgres
